# ── Supabase (database + auth) ─────────────────────────────
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API. NEXT_PUBLIC_* are safe for the browser;
# SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY — never expose it client-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── WhatsApp (legacy contact/order buttons) ────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=237XXXXXXXXX

# ── Sanity (legacy — being retired, safe to leave blank) ───
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
